{
  "name": "prodli",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:e2e": "pnpm --filter @workspace/prodli run test:e2e",
    "build:extension": "pnpm --filter @workspace/prodli run build:extension",
    "build:web": "node scripts/build-web.mjs",
    "dev:extension": "pnpm --filter @workspace/prodli run dev",
    "dev:site": "pnpm --filter @workspace/prodli-site run dev",
    "test:e2e:server": "pnpm --filter @workspace/prodli run test:e2e:server"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  }
}
