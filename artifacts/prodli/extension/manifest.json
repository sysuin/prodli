{
  "manifest_version": 3,
  "name": "ProdLi",
  "version": "1.4.0",
  "description": "Plan your day in every new tab: AI daily brief, Ask ProdLi, notes, to-dos, habits, focus tools and AI notes for any meeting.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "notifications",
    "tabs",
    "idle",
    "alarms",
    "identity",
    "contextMenus",
    "webNavigation",
    "search",
    "activeTab",
    "scripting"
  ],
  "optional_permissions": [
    "tabCapture",
    "offscreen",
    "downloads"
  ],
  "optional_host_permissions": [
    "https://meet.google.com/*",
    "file:///*"
  ],
  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Start or stop recording the current call (Meet, Zoom, Teams, Webex, Slack, Discord…)"
    },
    "quick-add": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Quick add a to-do or note to ProdLi"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ProdLi — click on a call's tab (Meet, Zoom, Teams, Webex, Slack, Discord…) to record",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
