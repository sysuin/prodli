{
  "manifest_version": 3,
  "name": "ProdLi",
  "version": "1.2.0",
  "description": "All-in-one workspace: notes, to-dos, Pomodoro, habits, time tracker, and AI meeting notes for Google Meet.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "notifications",
    "tabs",
    "idle",
    "alarms"
  ],
  "optional_permissions": ["scripting", "tabCapture", "offscreen"],
  "optional_host_permissions": ["<all_urls>"],
  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Start or stop recording the current Google Meet"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ProdLi — click on a Google Meet tab to record",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
