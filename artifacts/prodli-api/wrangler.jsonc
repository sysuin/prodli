// ProdLi's server: accounts, sync and AI (see docs/PLAN-WEB-APP.md).
//
//   pnpm --filter @workspace/prodli-api dev                 local (http://localhost:8787)
//   pnpm --filter @workspace/prodli-api deploy:staging      prodli-api-staging (workers.dev)
//   pnpm --filter @workspace/prodli-api deploy:production   prodli-api (app.prodli.com, from phase 1)
//
// Staging and production are separate Workers with separate data; nothing is
// shared between them. Secrets are set per environment with
// `wrangler secret put NAME --env <env>` and never live in this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prodli-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "vars": { "ENV": "development" },
  "env": {
    "staging": {
      "name": "prodli-api-staging",
      "workers_dev": true,
      "vars": { "ENV": "staging" }
    },
    "production": {
      "name": "prodli-api",
      // Served at app.prodli.com/api once phase 1 adds the route; no public URL until then.
      "workers_dev": false,
      "vars": { "ENV": "production" }
    }
  }
}
